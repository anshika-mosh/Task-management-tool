# Copy this file to .env.local (git-ignored) and fill it in, then restart `npm run dev` / `npm start`.
# NEVER put real credentials in this file: it is committed to git.

# --- MongoDB (required) ---------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=taskflow

# --- First-run data -------------------------------------------------------------
# true  = seed demo boards/tickets and demo logins (admin@taskflow.dev / admin123). Fine for development.
# false = create only one admin from the values below. USE THIS IN PRODUCTION.
SEED_DEMO_DATA=true
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Security -------------------------------------------------------------------
# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- Images & videos ------------------------------------------------------------
# Images/videos are attached as Google Drive links (Share -> "Anyone with the link").
# Set to true only if you also want to allow uploading files to this server's disk (.data/uploads).
ALLOW_FILE_UPLOADS=false

# --- Email notifications --------------------------------------------------------
# Public URL of this app (used for links inside emails).
APP_URL=http://localhost:3000
# Leave SMTP_HOST empty to only record emails in Admin -> Mail outbox instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@example.com>"
